{
  "name": "abn-teacher-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Teacher Management Portal \u2014 Ammar Baughe Nounehaal Higher Secondary School, Indore",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply abn-teacher-portal-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply abn-teacher-portal-db --remote",
    "create-admin:local": "node scripts/create-admin.mjs --local",
    "create-admin:remote": "node scripts/create-admin.mjs --remote",
    "setup:local": "npm run db:migrate:local && npm run create-admin:local",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "worker-mailer": "^1.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
